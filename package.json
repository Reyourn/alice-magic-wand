{
  "name": "alice-magic-wand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:composer": "npm run build && node scripts/validate-composer.mjs",
    "test:projects": "npm run build && node scripts/validate-project-discovery.mjs",
    "test:images": "npm run build && node scripts/validate-images.mjs",
    "test:files": "npm run build && node scripts/validate-files.mjs",
    "test:upgrade-ui": "npm run build && node scripts/validate-upgrade-ui.mjs",
    "test:upgrade-native": "tsx scripts/validate-upgrade-collaboration.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.295",
    "@dagrejs/dagre": "^3.1.1",
    "@fastify/static": "^10.1.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@xyflow/react": "^12.12.0",
    "exceljs": "4.4.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "mammoth": "1.13.0",
    "mermaid": "^12.2.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "saxes": "5.0.1",
    "zod": "^4.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "description": "爱丽丝的魔杖 · 本地多 Agent 协作工作台",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Reyourn/alice-magic-wand.git"
  }
}
